{
  "name": "ai-project-command-platform",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "多项目、模板化、AI 辅助更新的项目作战管理平台",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server.mjs",
    "migrate": "node scripts/migrate-db.mjs",
    "import:xugu": "node scripts/import-project.mjs --fixture fixtures/projects/xugu-agentic-group.json --project xugu-agentic-group",
    "export:xugu": "node scripts/export-project.mjs --project xugu-agentic-group --stdout",
    "backup": "node scripts/backup-database.mjs",
    "restore": "node scripts/restore-database.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "npx playwright test --reporter=list",
    "e2e:install": "npx playwright install chromium"
  },
  "dependencies": {
    "file-type": "22.0.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
