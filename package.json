{
  "name": "ai-project-command-platform",
  "version": "2.0.0-dev",
  "type": "module",
  "private": true,
  "description": "多项目、模板化、AI 辅助更新的项目作战管理平台",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0 <23"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts",
    "packages/database",
    "packages/domain",
    "packages/test-kit"
  ],
  "scripts": {
    "dev": "echo 'Use apps/api or apps/web dev scripts'",
    "build": "echo 'Use workspace build scripts'",
    "typecheck": "echo 'TODO: tsc --noEmit for all workspaces'",
    "lint": "echo 'TODO: eslint .'",
    "format": "echo 'TODO: prettier --write .'",
    "verify": "echo 'TODO: composite verify script'",
    "test": "echo 'TODO: vitest run'",
    "test:unit": "echo 'TODO: vitest run tests/unit'",
    "test:integration": "echo 'TODO: vitest run tests/integration'",
    "test:e2e": "echo 'TODO: playwright test'",

    "v1:start": "node server.mjs",
    "v1:start:background": "node scripts/manage-server.mjs start",
    "v1:stop": "node scripts/manage-server.mjs stop",
    "v1:status": "node scripts/manage-server.mjs status",
    "v1:restart": "node scripts/manage-server.mjs restart",
    "v1:migrate": "node scripts/migrate-db.mjs",
    "v1:test": "node --test --test-concurrency=1 test/*.test.mjs",
    "v1:test:e2e": "npx playwright test --reporter=list",
    "v1:verify": "node scripts/verify.mjs && node --test --test-concurrency=1 test/*.test.mjs && npx playwright test --reporter=list"
  }
}
