HOST=127.0.0.1
PORT=4173
PLATFORM_DATA_DIR=./data
PLATFORM_BOOTSTRAP_USERNAME=admin
PLATFORM_BOOTSTRAP_DISPLAY_NAME=平台管理员
# Optional: override the default bootstrap password (admin123).
# If omitted, first admin defaults to admin/admin123 and must change on login.
# PLATFORM_BOOTSTRAP_PASSWORD=
PLATFORM_COOKIE_SECURE=false

# Optional explicit seed for development/migration only. Release packages ship
# without project data and do not import any company fixture by default.
PLATFORM_SEED_FIXTURE=
PLATFORM_SEED_PROJECT_ID=

# Optional OpenAI-compatible providers. Keep real keys in ignored .env.local.
AI_CHAT_PROVIDER=disabled
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_ALLOWED_HOSTS=

AI_GENERATION_PROVIDER=disabled
AI_GENERATION_BASE_URL=
AI_GENERATION_API_KEY=
AI_GENERATION_MODEL=
AI_GENERATION_ALLOWED_HOSTS=
AI_GENERATION_REASONING_EFFORT=
AI_GENERATION_PROVIDER_LABEL=
