{
  "name": "ai-project-command-platform",
  "version": "0.9.2",
  "type": "module",
  "description": "多项目、模板化、AI 辅助更新的项目作战管理平台",
  "license": "MIT",
  "engines": {
    "node": ">=22.0"
  },
  "bin": {
    "ai-project-command-platform": "./server.mjs"
  },
  "files": [
    "server.mjs",
    "src/",
    "public/",
    "fixtures/",
    "scripts/",
    ".env.example",
    "README.md"
  ],
  "pkg": {
    "assets": [
      "public/**/*",
      "src/db/migrations/*.sql",
      "fixtures/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server.mjs",
    "start:background": "node scripts/manage-server.mjs start",
    "stop": "node scripts/manage-server.mjs stop",
    "status": "node scripts/manage-server.mjs status",
    "restart": "node scripts/manage-server.mjs restart",
    "migrate": "node scripts/migrate-db.mjs",
    "import:xugu": "node scripts/import-project.mjs --fixture fixtures/projects/xugu-agentic-group.json --project xugu-agentic-group",
    "export:xugu": "node scripts/export-project.mjs --project xugu-agentic-group --stdout",
    "backup": "node scripts/backup-database.mjs",
    "restore": "node scripts/restore-database.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:e2e": "npx playwright test --reporter=list",
    "test:e2e:abnormal": "npx playwright test --config=playwright.abnormal.config.mjs",
    "e2e:install": "npx playwright install chromium",
    "build:pkg": "node scripts/build-native.mjs",
    "build:deb": "node scripts/build-packages.mjs deb",
    "build:rpm": "node scripts/build-packages.mjs rpm",
    "build:macos": "node scripts/build-packages.mjs macos",
    "build:win": "node scripts/build-packages.mjs win",
    "build:all": "node scripts/build-packages.mjs all",
    "build:xugu:deb": "node scripts/build-packages.mjs deb --with-xugu",
    "build:xugu:rpm": "node scripts/build-packages.mjs rpm --with-xugu",
    "build:xugu:macos": "node scripts/build-packages.mjs macos --with-xugu",
    "build:xugu:win": "node scripts/build-packages.mjs win --with-xugu",
    "build:xugu:all": "node scripts/build-packages.mjs all --with-xugu",
    "prepublishOnly": "node --test \"test/*.test.mjs\" && node scripts/verify.mjs"
  },
  "dependencies": {
    "file-type": "22.0.1",
    "odbc": "^2.5.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
